    {
      "parameters": {
        "jsCode": "console.log(\"=== CHECKING SHEET FOR SCHEDULED POSTS ===\");\n\n// Get current IST time\nconst currentTime = new Date();\nconst istOffset = 5.5 * 60;\nconst utc = currentTime.getTime() + (currentTime.getTimezoneOffset() * 60 * 1000);\nconst istTime = new Date(utc + (istOffset * 60 * 1000));\n\nconst currentHour = istTime.getHours();\nconst currentMinute = istTime.getMinutes();\nconst currentTimeString = `${currentHour}:${currentMinute.toString().padStart(2, '0')}`;\n\nconsole.log(`Current IST Time: ${istTime.toISOString()}`);\nconsole.log(`Current Time String: ${currentTimeString}`);\n\nconst allItems = $input.all();\nconsole.log(`Total items received: ${allItems.length}`);\n\nif (allItems.length === 0) {\n  console.log(\"❌ NO ITEMS FOUND IN INPUT!\");\n  return [];\n}\n\n// Filter items that should be posted now\nconst itemsToPost = allItems.filter(item => {\n  const postAction = item.json['Post Action'];\n  const scheduleTime = item.json['SCHEDULE TIME']; \n  const progress = item.json['Progress'];\n  const clientName = item.json['Client Name'];\n  \n  console.log(`\\n--- Checking Item: ${clientName} ---`);\n  console.log(`Post Action: \"${postAction}\"`);\n  console.log(`Schedule Time: \"${scheduleTime}\"`);\n  console.log(`Progress: \"${progress}\"`);\n  \n  // STOP if Progress is already \"Posted\"\n  if (progress === 'Posted') {\n    console.log(`❌ Already posted - skipping`);\n    return false;\n  }\n  \n  // Check if Post Action is \"Post\" (not \"Schedule\")\n  const shouldPost = postAction === 'Post';\n  if (!shouldPost) {\n    console.log(`❌ Post Action is \"${postAction}\", not \"Post\"`);\n    return false;\n  }\n  \n  // Parse and check schedule time\n  let isTimeToPost = false;\n  if (scheduleTime) {\n    // Handle different time formats from your sheet\n    let timeString = scheduleTime;\n    \n    // If it's in format \"23:59:00\", extract just \"23:59\"\n    if (timeString.includes(':') && timeString.split(':').length === 3) {\n      const timeParts = timeString.split(':');\n      timeString = `${timeParts[0]}:${timeParts[1]}`;\n    }\n    \n    console.log(`Cleaned schedule time: \"${timeString}\"`);\n    \n    if (timeString.includes(':')) {\n      const [scheduleHour, scheduleMinute] = timeString.split(':').map(Number);\n      \n      // Check if current time is within 30 minutes of scheduled time\n      const scheduledTotalMinutes = scheduleHour * 60 + scheduleMinute;\n      const currentTotalMinutes = currentHour * 60 + currentMinute;\n      const timeDifference = Math.abs(currentTotalMinutes - scheduledTotalMinutes);\n      \n      // Post if we're within 30 minutes of scheduled time\n      isTimeToPost = scheduleHour === currentHour && scheduleMinute === currentMinute;\n\n      \n      console.log(`Scheduled: ${scheduleHour}:${scheduleMinute.toString().padStart(2, '0')}`);\n      console.log(`Time difference: ${timeDifference} minutes`);\n      console.log(`Is time to post: ${isTimeToPost}`);\n    }\n  }\n  \n  // Check if there's content to post\n  const hasContent = item.json['Facebook content'] || item.json['Insta content'] || item.json['Youtube content'];\n  \n  const shouldProcessItem = shouldPost && isTimeToPost && hasContent;\n  \n  console.log(`Should process: ${shouldProcessItem}`);\n  console.log(`  - Should post: ${shouldPost}`);\n  console.log(`  - Is time to post: ${isTimeToPost}`);\n  console.log(`  - Has content: ${hasContent}`);\n  console.log(`  - Progress not \"Posted\": ${progress !== 'Posted'}`);\n  \n  return shouldProcessItem;\n});\n\nconsole.log(`\\n=== FINAL RESULT ===`);\nconsole.log(`Items to post now: ${itemsToPost.length}`);\n\nif (itemsToPost.length > 0) {\n  itemsToPost.forEach((item, index) => {\n    console.log(`${index + 1}. ${item.json['Client Name']} - ${item.json['SCHEDULE TIME']}`);\n  });\n}\n\nreturn itemsToPost;"
      },
